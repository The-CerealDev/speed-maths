# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Incomplete pillars — untracked until their sheet runs are finished.
# Remove a line here when its pillar is ready to publish.
geometry/

# Local research corpus: fetched past papers (UKMT/OCR/Oxford copyright).
# NEVER commit these — the repo is public. Archetype indexes stay local too
# since they quote question content.
research/

# AI state and config files
.agents/
.claude/
.cursor/
CONTEXT.md
ORIGINAL_REQUEST.md
PROJECT.md

# Python
__pycache__/
*.pyc
*.pyo

# Worksheets rendered from past papers — copyrighted question text.
worksheets/

# Variant Retriever. Never on a branch that reaches this public repo: its
# data/ holds account records and invite codes, and .hydrate_cache/,
# .page_cache/ and official.json hold verbatim text and page images of
# third-party and official papers. The retriever's own source lives on an
# unpushed local branch; nothing about it belongs here.
variant_retriever/

# Security
**/.env
**/.session_secret
mutants/
